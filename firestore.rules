rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'createdAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['patient', 'doctor', 'admin'] &&
             data.createdAt is timestamp;
    }

    function isValidDoctor(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.specialty is string &&
             data.fee is number && data.fee >= 0;
    }

    function isValidAppointment(data) {
      return data.patientId == request.auth.uid &&
             data.doctorId is string &&
             data.status in ['scheduled', 'waiting', 'in-progress', 'completed', 'cancelled'] &&
             data.createdAt == request.time;
    }

    function isValidEHR(data) {
      return data.patientId is string &&
             data.doctorId is string &&
             data.appointmentId is string;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone']);
    }

    // 2. Doctors Collection
    match /doctors/{doctorId} {
      allow read: if true; 
      allow create, update, delete: if true; // Allowed for demo seeding, reach out to secure
    }

    // 3. Appointments Collection
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && (isOwner(existing().patientId) || isOwner(existing().doctorId));
      allow list: if isSignedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid);
      allow create: if isSignedIn() && isValidAppointment(incoming()) && isValidId(appointmentId);
      allow update: if isSignedIn() && (isOwner(existing().patientId) || isOwner(existing().doctorId)) &&
                    incoming().diff(existing()).affectedKeys().hasAll(['status']) &&
                    incoming().status in ['completed', 'cancelled', 'waiting'];
    }

    // 4. EHRs Collection
    match /ehrs/{ehrId} {
      allow get: if isSignedIn() && (isOwner(existing().patientId) || isOwner(existing().doctorId));
      allow list: if isSignedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().doctorId) && isValidEHR(incoming());
    }
  }
}
